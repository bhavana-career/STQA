# Copy to .env for local development. PLACEHOLDER VALUES ONLY — never commit a real .env.
# The app loads .env automatically in development/testing (python-dotenv).

# development | testing | production
APP_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Local PostgreSQL started by `docker compose up -d db` (see docker-compose.yml)
DATABASE_URL=postgresql+psycopg://srms:srms_local_pw@localhost:5433/srms_dev

# Used ONLY by the automated test suite. Database name MUST contain "test".
TEST_DATABASE_URL=postgresql+psycopg://srms:srms_local_pw@localhost:5433/srms_test

# CAPTCHA: "turnstile" everywhere except automated tests, which may use "mock".
CAPTCHA_MODE=turnstile
# Cloudflare's documented ALWAYS-PASS test keys — fine for local dev, REJECTED in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Comma-separated hostnames accepted in the siteverify response (production: your-app.onrender.com)
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1,example.com

# Optional tuning
SESSION_LIFETIME_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOG_LEVEL=INFO

# Only for the one-off `flask seed-demo` command; leave unset otherwise.
# DEMO_STUDENT_PASSWORD=
# DEMO_TEACHER_PASSWORD=
